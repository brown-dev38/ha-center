<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="PatientBed_Proxy" stopProcessing="true">
          <match url="^patient-bed(.*)" />
          <action type="Rewrite" url="http://localhost:3002/patient-bed{R:1}" appendQueryString="true" />
        </rule>
        
        <rule name="SystemRLS_Proxy" stopProcessing="true">
          <match url="^system-rls(.*)" />
          <action type="Rewrite" url="http://localhost:3003/system-rls{R:1}" appendQueryString="true" />
        </rule>

        <rule name="HA_Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
