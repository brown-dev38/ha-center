generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Organization ───────────────────────────────────────────

model Role {
  // รหัสมาตรฐาน ROLE-ADMIN (จัดสรรผ่าน formatRoleId — ไม่ใช้ cuid)
  id          String   @id
  name        String   @unique
  displayName String   @map("display_name")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

/// คลังคีย์/ค่าแบบ JSON สำหรับตั้งค่าระบบหลังบ้าน (site settings, เมนู, ข้อความหัวข้อ)
model AppSetting {
  key       String   @id @default(cuid())
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}

model Department {
  // รหัสมาตรฐาน DEPT-HA (จัดสรรผ่าน formatDepartmentId — ไม่ใช้ cuid)
  id        String   @id
  code      String   @unique
  name      String
  nameEn    String?  @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  indicators         Indicator[]
  indicatorValues    IndicatorValue[]
  cqiProjects        CqiProject[]
  kmSessions         KmSession[]
  serviceProfiles    ServiceProfile[]
  unitProfileWorksheets UnitProfileWorksheet[]

  @@index([code])
  @@map("departments")
}

model User {
  // รหัสมาตรฐาน USR-0001 (จัดสรรผ่าน allocateUserId — ไม่ใช้ cuid)
  id           String    @id
  username     String?   @unique
  email        String    @unique
  microsoftOid String?   @unique @map("microsoft_oid")
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  employeeId   String?   @map("employee_id")
  jobTitle     String?   @map("job_title")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  lineUserId   String?   @map("line_user_id")
  roleId       String    @map("role_id")
  departmentId String?   @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  documentsUploaded    HaDocument[]          @relation("UploadedBy")
  documentVersions     DocumentVersion[]
  documentDownloads    DocumentDownloadLog[]
  newsAuthored         News[]
  meetingsOrganized    Meeting[]            @relation("Organizer")
  meetingParticipants  MeetingParticipant[]
  meetingMinutes       MeetingMinute[]
  agendaPresentations  MeetingAgenda[]      @relation("AgendaPresenter")
  indicatorValues      IndicatorValue[]
  kmSessions           KmSession[]
  kmResults            KmResult[]
  kmInnovations        KmInnovation[]
  cqiProjectsLed       CqiProject[]         @relation("ProjectLead")
  userProgress         UserProgress[]
  certificates         Certificate[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  worksheetsPrepared   UnitProfileWorksheet[] @relation("WorksheetPreparedBy")
  worksheetVersions    UnitProfileWorksheetVersion[] @relation("WorksheetVersionBy")
  worksheetDownloads   UnitProfileWorksheetDownloadLog[]
  haV6StatesUpdated    HaV6DocumentState[] @relation("HaV6StateUpdatedBy")
  haV6FilesUploaded    HaV6TrackerFile[]   @relation("HaV6FileUploadedBy")

  @@index([email])
  @@index([username])
  @@index([departmentId])
  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

// ─── Documents ─────────────────────────────────────────────────────

model DocumentCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents HaDocument[]

  @@map("document_categories")
}

model HaDocument {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  documentNo   String?  @map("document_no")
  sectionNo    String?  @map("section_no")
  haStandard   String?  @map("ha_standard")
  categoryId   String   @map("category_id")
  uploadedById String   @map("uploaded_by_id")
  accessLevel  String   @default("internal") @map("access_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category     DocumentCategory      @relation(fields: [categoryId], references: [id])
  uploadedBy   User                  @relation("UploadedBy", fields: [uploadedById], references: [id])
  versions     DocumentVersion[]
  downloadLogs DocumentDownloadLog[]

  @@index([categoryId])
  @@index([uploadedById])
  @@index([accessLevel])
  @@index([isActive])
  @@index([sectionNo])
  @@index([documentNo])
  @@index([createdAt])
  @@map("ha_documents")
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  version      String
  fileUrl      String   @map("file_url")
  filePath     String   @default("db:inline") @map("file_path")
  fileData     Bytes?   @map("file_data") @db.LongBlob
  fileName     String   @map("file_name")
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type")
  uploadedById String   @map("uploaded_by_id")
  changeNote   String?  @map("change_note") @db.Text
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document     HaDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User                  @relation(fields: [uploadedById], references: [id])
  downloadLogs DocumentDownloadLog[]

  @@index([documentId])
  @@index([createdAt])
  @@map("document_versions")
}

/// สถานะจัดทำ HA v6 ต่อรายการเอกสาร (แชร์ทั้งองค์กร)
model HaV6DocumentState {
  documentId      String   @id @map("document_id") @db.VarChar(120)
  status          String   @default("not_started") @db.VarChar(32)
  progressPercent Int      @default(0) @map("progress_percent")
  storageItems    Json     @default("[]") @map("storage_items")
  remarks         String   @db.Text
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedBy User?             @relation("HaV6StateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  files     HaV6TrackerFile[]

  @@index([status])
  @@index([updatedAt])
  @@map("ha_v6_document_states")
}

/// ไฟล์แนบในตารางติดตาม HA v6
model HaV6TrackerFile {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id") @db.VarChar(120)
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type") @db.VarChar(120)
  fileSize     Int      @map("file_size")
  filePath     String   @default("db:inline") @map("file_path") @db.VarChar(512)
  fileData     Bytes?   @map("file_data") @db.LongBlob
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  document   HaV6DocumentState @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  uploadedBy User              @relation("HaV6FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([documentId])
  @@index([uploadedById])
  @@map("ha_v6_tracker_files")
}

model DocumentDownloadLog {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  versionId  String?  @map("version_id")
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  document HaDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
  @@map("document_download_logs")
}

// ─── News ──────────────────────────────────────────────────────────

model NewsCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  news News[]

  @@map("news_categories")
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.LongText
  excerpt     String?   @db.Text
  coverImage  String?   @map("cover_image")
  categoryId  String    @map("category_id")
  authorId    String    @map("author_id")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category NewsCategory @relation(fields: [categoryId], references: [id])
  author   User         @relation(fields: [authorId], references: [id])

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("news")
}

model RelatedLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?  @db.Text
  iconUrl     String?  @map("icon_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("related_links")
}

model ConsultRequest {
  id         String   @id @default(cuid())
  topic      String
  department String
  name       String
  email      String
  phone      String?
  urgent     Boolean  @default(false)
  message    String   @db.Text
  status     String   @default("new")
  handledBy  String?  @map("handled_by")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([urgent])
  @@index([createdAt])
  @@map("consult_requests")
}

// ─── Meetings ──────────────────────────────────────────────────────

model MeetingRoom {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  capacity  Int?
  location  String?
  equipment String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meetings Meeting[]

  @@map("meeting_rooms")
}

model Meeting {
  id                String   @id @default(cuid())
  title             String
  description       String?  @db.Text
  type              String   @default("general")
  roomId            String?  @map("room_id")
  organizerId       String   @map("organizer_id")
  startAt           DateTime @map("start_at")
  endAt             DateTime @map("end_at")
  status            String   @default("scheduled")
  bookingStatus     String   @default("pending") @map("booking_status")
  preparationStatus String   @default("not_started") @map("preparation_status")
  preparationNotes  String?  @map("preparation_notes") @db.Text
  location          String?
  isOnline          Boolean  @default(false) @map("is_online")
  meetingUrl        String?  @map("meeting_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  room         MeetingRoom?           @relation(fields: [roomId], references: [id])
  organizer    User                   @relation("Organizer", fields: [organizerId], references: [id])
  participants MeetingParticipant[]
  agendas      MeetingAgenda[]
  minutes      MeetingMinute[]
  checklist    MeetingChecklistItem[]

  @@index([organizerId])
  @@index([roomId])
  @@index([status])
  @@index([type])
  @@index([startAt])
  @@index([createdAt])
  @@map("meetings")
}

model MeetingParticipant {
  id             String   @id @default(cuid())
  meetingId      String   @map("meeting_id")
  userId         String?  @map("user_id")
  displayName    String?  @map("display_name")
  departmentName String?  @map("department_name")
  positionTitle  String?  @map("position_title")
  status         String   @default("invited")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingAgenda {
  id                     String   @id @default(cuid())
  meetingId              String   @map("meeting_id")
  title                  String
  description            String?  @db.Text
  orderNo                Int      @default(0) @map("order_no")
  sortOrder              Int      @default(0) @map("sort_order")
  durationMinutes        Int?     @map("duration_minutes")
  presenterId            String?  @map("presenter_id")
  presenterName          String?  @map("presenter_name")
  attachmentPath         String?  @map("attachment_path")
  attachmentFileName     String?  @map("attachment_file_name")
  attachmentFileSize     Int?     @map("attachment_file_size")
  actualDurationSeconds  Int?     @map("actual_duration_seconds")
  timerStatus            String?  @map("timer_status")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  presenter User?   @relation("AgendaPresenter", fields: [presenterId], references: [id])

  @@index([meetingId])
  @@index([presenterId])
  @@map("meeting_agendas")
}

model MeetingMinute {
  id        String   @id @default(cuid())
  meetingId String   @map("meeting_id")
  summary   String?  @db.Text
  content   String?  @db.LongText
  filePath  String?  @map("file_path")
  fileName  String?  @map("file_name")
  fileSize  Int?     @map("file_size")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([meetingId])
  @@map("meeting_minutes")
}

model MeetingChecklistItem {
  id          String   @id @default(cuid())
  meetingId   String   @map("meeting_id")
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_checklist_items")
}

// ─── Indicators (KPI) ──────────────────────────────────────────────

model IndicatorCategory {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  indicators Indicator[]

  @@map("indicator_categories")
}

model Indicator {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?  @db.Text
  unit            String?
  targetValue     Float?   @map("target_value")
  targetDirection String   @default("higher") @map("target_direction")
  categoryId      String   @map("category_id")
  departmentId    String?  @map("department_id")
  frequency       String   @default("monthly")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category   IndicatorCategory @relation(fields: [categoryId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  values     IndicatorValue[]

  @@index([categoryId])
  @@index([departmentId])
  @@map("indicators")
}

model IndicatorValue {
  id           String   @id @default(cuid())
  indicatorId  String   @map("indicator_id")
  departmentId String?  @map("department_id")
  period       String
  value        Float
  note         String?  @db.Text
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  indicator  Indicator   @relation(fields: [indicatorId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  recordedBy User?       @relation(fields: [recordedById], references: [id])

  @@unique([indicatorId, departmentId, period])
  @@index([indicatorId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("indicator_values")
}

// ─── Knowledge Management ──────────────────────────────────────────

model KmSession {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  sessionDate   DateTime @map("session_date")
  fiscalYear    Int?     @map("fiscal_year")
  departmentId  String?  @map("department_id")
  presenterId   String   @map("presenter_id")
  location      String?
  status        String   @default("planned")
  filePath      String?  @map("file_path")
  fileName      String?  @map("file_name")
  fileSize      Int?     @map("file_size")
  fileData      Bytes?   @map("file_data") @db.LongBlob
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  department   Department?    @relation(fields: [departmentId], references: [id])
  presenter    User           @relation(fields: [presenterId], references: [id])
  results      KmResult[]
  innovations  KmInnovation[]

  @@index([departmentId])
  @@index([presenterId])
  @@index([fiscalYear])
  @@index([sessionDate])
  @@index([createdAt])
  @@map("km_sessions")
}

model KmResult {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  type        String   @default("system")
  title       String
  description String?  @db.Text
  summary     String?  @db.Text
  imageUrl    String?  @map("image_url")
  systemUrl   String?  @map("system_url")
  fileUrl     String?  @map("file_url")
  year        Int?
  authorId    String   @map("author_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session KmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])

  @@index([sessionId])
  @@index([type])
  @@index([year])
  @@map("km_results")
}

model KmInnovation {
  id              String   @id @default(cuid())
  sessionId       String?  @map("session_id")
  title           String
  innovationType  String?  @map("innovation_type")
  description     String   @db.Text
  result          String?  @db.Text
  impact          String?  @db.Text
  year            Int?
  authorId        String   @map("author_id")
  departmentId    String?  @map("department_id")
  status          String   @default("draft")
  fileUrl         String?  @map("file_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session    KmSession?  @relation(fields: [sessionId], references: [id])
  author     User        @relation(fields: [authorId], references: [id])

  @@index([sessionId])
  @@index([authorId])
  @@index([year])
  @@index([createdAt])
  @@map("km_innovations")
}

// ─── CQI ───────────────────────────────────────────────────────────

model CqiProject {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  departmentId  String?   @map("department_id")
  leadId        String    @map("lead_id")
  year          Int?
  status        String    @default("active")
  planDetail    String?   @map("plan_detail") @db.Text
  doDetail      String?   @map("do_detail") @db.Text
  checkDetail   String?   @map("check_detail") @db.Text
  actDetail     String?   @map("act_detail") @db.Text
  isOutstanding Boolean   @default(false) @map("is_outstanding")
  awardName     String?   @map("award_name")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  pdsaCycle     String?   @map("pdsa_cycle")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])
  lead       User        @relation("ProjectLead", fields: [leadId], references: [id])
  awards     CqiAward[]

  @@index([departmentId])
  @@index([leadId])
  @@index([year])
  @@index([status])
  @@index([isOutstanding])
  @@index([isActive])
  @@index([createdAt])
  @@map("cqi_projects")
}

model CqiAward {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  awardName   String   @map("award_name")
  awardLevel  String?  @map("award_level")
  awardedAt   DateTime @map("awarded_at")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project CqiProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("cqi_awards")
}

// ─── Service Profiles ──────────────────────────────────────────────

model ServiceProfile {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  departmentId String?  @map("department_id")
  serviceType  String?  @map("service_type")
  standardRef  String?  @map("standard_ref")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("service_profiles")
}

model UnitProfileWorksheet {
  id           String    @id
  departmentId String    @map("department_id")
  year         Int
  title        String
  status       String    @default("draft")
  isHidden     Boolean   @default(false) @map("is_hidden")
  formData     Json      @map("form_data")
  preparedById String    @map("prepared_by_id")
  submittedAt  DateTime? @map("submitted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department Department                        @relation(fields: [departmentId], references: [id])
  preparedBy User                              @relation("WorksheetPreparedBy", fields: [preparedById], references: [id])
  versions   UnitProfileWorksheetVersion[]
  downloads  UnitProfileWorksheetDownloadLog[]

  @@index([departmentId, status])
  @@index([departmentId, year])
  @@index([preparedById])
  @@index([status])
  @@index([isHidden])
  @@map("unit_profile_worksheets")
}

model UnitProfileWorksheetVersion {
  id            String   @id
  worksheetId   String   @map("worksheet_id")
  versionNo     Int      @map("version_no")
  pdfPath       String?  @map("pdf_path")
  docPath       String?  @map("doc_path")
  pdfSize       Int?     @map("pdf_size")
  docSize       Int?     @map("doc_size")
  generatedAt   DateTime @default(now()) @map("generated_at")
  generatedById String   @map("generated_by_id")

  worksheet   UnitProfileWorksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  generatedBy User                 @relation("WorksheetVersionBy", fields: [generatedById], references: [id])
  downloads   UnitProfileWorksheetDownloadLog[]

  @@unique([worksheetId, versionNo])
  @@index([worksheetId])
  @@map("unit_profile_worksheet_versions")
}

model UnitProfileWorksheetDownloadLog {
  id          String   @id @default(cuid())
  worksheetId String   @map("worksheet_id")
  versionId   String?  @map("version_id")
  userId      String?  @map("user_id")
  format      String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  worksheet UnitProfileWorksheet         @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  version   UnitProfileWorksheetVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user      User?                        @relation(fields: [userId], references: [id])

  @@index([worksheetId])
  @@index([userId])
  @@map("unit_profile_worksheet_download_logs")
}

// ─── E-learning ────────────────────────────────────────────────────

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  thumbnail     String?
  passScore     Int      @default(70) @map("pass_score")
  durationHours Float?   @map("duration_hours")
  isPublished   Boolean  @default(false) @map("is_published")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lessons      Lesson[]
  quiz         Quiz?
  userProgress UserProgress[]
  certificates Certificate[]

  @@index([isPublished])
  @@index([isActive])
  @@index([createdAt])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  content     String?  @db.LongText
  contentType String   @default("video") @map("content_type")
  contentUrl  String?  @map("content_url")
  videoUrl    String?  @map("video_url")
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  orderNo     Int      @default(0) @map("order_no")
  sortOrder   Int      @default(0) @map("sort_order")
  duration    Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([orderNo])
  @@map("lessons")
}

model Quiz {
  id        String   @id @default(cuid())
  courseId  String   @unique @map("course_id")
  title     String   @default("แบบทดสอบวัดผล")
  passScore Int      @default(70) @map("pass_score")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String   @map("quiz_id")
  question      String   @db.Text
  optionA       String   @map("option_a") @db.Text
  optionB       String   @map("option_b") @db.Text
  optionC       String   @map("option_c") @db.Text
  optionD       String   @map("option_d") @db.Text
  correctOption String   @map("correct_option")
  explanation   String?  @db.Text
  options       Json?    @db.Json
  correctAnswer String?  @map("correct_answer")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  lessonId    String?   @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  score       Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@map("user_progress")
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  courseId       String   @map("course_id")
  certificateNo  String   @unique @map("certificate_no")
  verifyCode     String   @unique @map("verify_code")
  score          Float?
  passed         Boolean  @default(true)
  filePath       String?  @map("file_path")
  issuedAt       DateTime @default(now()) @map("issued_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([verifyCode])
  @@map("certificates")
}

// ─── Notifications & Logs ──────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model LineOaLog {
  id        String   @id @default(cuid())
  eventType String   @map("event_type")
  userId    String?  @map("line_user_id")
  payload   Json     @db.Json
  status    String   @default("received")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventType])
  @@index([createdAt])
  @@map("line_oa_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  oldData    Json?    @map("old_data") @db.Json
  newData    Json?    @map("new_data") @db.Json
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
