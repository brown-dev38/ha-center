# คัดลอกเป็น .env.local บน server รพ. (C:\ha-center\web)
# URL สาธารณะ: https://hacenter.uph.up.ac.th

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/ha_center"

# NextAuth — ใช้ URL สาธารณะ (HTTPS) ไม่ใส่ :3000
AUTH_SECRET="ใส่ค่า-hex-64-ตัวอักษร"
AUTH_URL=https://hacenter.uph.up.ac.th
AUTH_TRUST_HOST=true

NEXT_PUBLIC_SITE_URL=https://hacenter.uph.up.ac.th
DEPLOYMENT_TARGET=onprem
NEXT_PUBLIC_DEMO_MODE=false

# Microsoft Login — ใส่ในเครื่องหมายคำพูดเสมอ (secret มักขึ้นต้นด้วย -)
MICROSOFT_LOGIN_ENABLED=true
AZURE_TENANT_ID=d7cbbb08-47a3-4bd7-8347-5018f2744cfb
AZURE_CLIENT_ID=adc16d9a-371c-4848-b73a-c76174900896
AZURE_CLIENT_SECRET="วาง-Value-จาก-Azure"
AZURE_ALLOWED_DOMAINS=up.ac.th

# ปิด login รหัสผ่านบน production
DEV_LOGIN_ENABLED=false

# บทบาทเริ่มต้นเมื่อสร้างผู้ใช้จาก Microsoft (ผู้จัดการเอกสาร)
AZURE_DEFAULT_ROLE=document_manager

MEETING_UPLOAD_DIR=C:\data\ha-center\uploads\meetings
ELEARNING_UPLOAD_DIR=C:\data\ha-center\uploads\elearning
DOCUMENT_UPLOAD_DIR=C:\data\ha-center\uploads\documents
WORKSHEET_UPLOAD_DIR=C:\data\ha-center\uploads\worksheets
