{
  "name": "@ha-center/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ha-center",
    "pm2:restart": "pm2 restart ha-center",
    "lint": "next lint",
    "db:push": "dotenv -e .env -e .env.local -- prisma db push --schema prisma/schema.prisma",
    "db:migrate-documents": "dotenv -e .env -e .env.local -- tsx prisma/migrate-documents-to-db.ts",
    "db:migrate-worksheet-ids": "dotenv -e .env -e .env.local -- tsx prisma/migrate-worksheet-ids.ts",
    "db:migrate-user-ids": "dotenv -e .env -e .env.local -- tsx prisma/migrate-user-ids.ts",
    "db:migrate-role-ids": "dotenv -e .env -e .env.local -- tsx prisma/migrate-role-ids.ts",
    "db:migrate-department-ids": "dotenv -e .env -e .env.local -- tsx prisma/migrate-department-ids.ts",
    "db:migrate-all-entity-ids": "dotenv -e .env -e .env.local -- tsx prisma/migrate-all-entity-ids.ts",
    "db:migrate-all-ids": "npm run db:migrate-user-ids && npm run db:migrate-role-ids && npm run db:migrate-department-ids && npm run db:migrate-worksheet-ids && npm run db:migrate-all-entity-ids",
    "db:promote-admin": "dotenv -e .env -e .env.local -- tsx prisma/promote-user-admin.ts",
    "db:promote-ms-doc-managers": "dotenv -e .env -e .env.local -- tsx prisma/promote-microsoft-document-managers.ts",
    "db:seed": "dotenv -e .env -e .env.local -- prisma db seed",
    "db:test": "dotenv -e .env -e .env.local -- prisma db execute --file prisma/test-connection.sql --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.59.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "googleapis": "^148.0.0",
    "html2canvas-pro": "^2.2.3",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.15.0",
    "prisma": "5.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
